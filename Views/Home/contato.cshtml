@{
    ViewData["Title"] = "Contato";
}

<div class="body-formulario">
    <div class="card-formulario">
        <h2 class="titulo-uninove">UNINOVE</h2>
        
        <form method="POST">
            <label class="label-campo" for="nome">Nome:</label>
            <input type="text" id="nome" class="input-campo" required />

            <label class="label-campo" for="email">Email:</label>
            <input type="email" id="email" class="input-campo" required />

            <label class="label-campo" for="assunto">Assunto:</label>
            <select id="assunto" class="input-campo">
                <option value="">Selecione um assunto</option>
                <option value="duvida">Dúvida</option>
                <option value="sugestao">Sugestão</option>
                <option value="suporte">Suporte Técnico</option>
            </select>

            <label class="label-campo" for="mensagem">Mensagem:</label>
            <textarea id="mensagem" class="input-campo" rows="4"></textarea>

            <button type="submit" class="botao-roxo">Enviar</button>
        </form>
    </div>
</div>