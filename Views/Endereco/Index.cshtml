@model AULA_HTML.Models.EnderecoModel

@{
    ViewData["Title"] = "Buscar Endereço via CEP";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4 text-center">Buscar Endereço (ViaCEP)</h2>

    <form asp-action="Salvar" asp-controller="Endereco" method="post" class="card p-4 shadow-sm">
        
        <div class="mb-3">
            <label asp-for="Cep" class="form-label">CEP</label>
            <input asp-for="Cep" id="cep" class="form-control" placeholder="Digite o CEP (Ex: 01001000)" maxlength="9" />
            <span asp-validation-for="Cep" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Logradouro" class="form-label">Logradouro</label>
            <input asp-for="Logradouro" id="logradouro" class="form-control" readonly style="background-color: #e9ecef;" />
        </div>

        <div class="mb-3">
            <label asp-for="Bairro" class="form-label">Bairro</label>
            <input asp-for="Bairro" id="bairro" class="form-control" readonly style="background-color: #e9ecef;" />
        </div>

        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="Cidade" class="form-label">Cidade</label>
                <input asp-for="Cidade" id="cidade" class="form-control" readonly style="background-color: #e9ecef;" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Uf" class="form-label">UF</label>
                <input asp-for="Uf" id="uf" class="form-control" readonly style="background-color: #e9ecef;" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Numero" class="form-label">Número</label>
                <input asp-for="Numero" class="form-control" placeholder="Ex: 123" />
                <span asp-validation-for="Numero" class="text-danger small"></span>
            </div>
            <div class="col-md-8 mb-3">
                <label asp-for="Complemento" class="form-label">Complemento (Opcional)</label>
                <input asp-for="Complemento" class="form-control" placeholder="Ex: Apto 42" />
            </div>
        </div>

        <button type="submit" class="btn btn-success w-100 mt-2">Enviar para o Servidor</button>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Monitora o campo de CEP quando o usuário tira o foco dele (blur)
            $("#cep").blur(function () {
                var cep = $(this).val().replace(/\D/g, '');

                if (cep != "") {
                    var validaCep = /^[0-9]{8}$/;

                    if(validaCep.test(cep)) {
                        // Preenche com "..." enquanto consulta a API externa
                        $("#logradouro").val("...");
                        $("#bairro").val("...");
                        $("#cidade").val("...");
                        $("#uf").val("...");

                        // Requisição AJAX para o ViaCEP
                        $.getJSON("https://viacep.com.br/ws/" + cep + "/json/?callback=?", function (dados) {
                            if (!("erro" in dados)) {
                                // Atualiza os campos com os dados retornados pela API
                                $("#logradouro").val(dados.logradouro);
                                $("#bairro").val(dados.bairro);
                                $("#cidade").val(dados.localidade);
                                $("#uf").val(dados.uf);
                            } else {
                                alert("CEP não encontrado.");
                                limparFormulario();
                            }
                        });
                    } else {
                        alert("Formato de CEP inválido.");
                        limparFormulario();
                    }
                } else {
                    limparFormulario();
                }
            });

            function limparFormulario() {
                $("#cep").val("");
                $("#logradouro").val("");
                $("#bairro").val("");
                $("#cidade").val("");
                $("#uf").val("");
            }
        });
    </script>
}